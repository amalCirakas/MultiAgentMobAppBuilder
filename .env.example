# Copy to .env and fill in secrets (see README).
# The generator loads `.env` from the project root automatically.

LLM_PROVIDER=gemini
MODULE=patients

# Gemini (default provider)
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# Anthropic (optional)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Groq via LiteLLM (optional — requires litellm; see README)
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.1-8b-instant
#
# On ``on_demand`` tiers, TPM can be tight; ui/qa tasks use shorter prompts automatically.
# Lower this value if Crew still logs ``Requested … Limit 6000`` on Groq:

# GROQ_BUILDER_PROMPT_MAX_CHARS=1800

# Staged pipeline: one LLM-backed step at a time; retries are per-stage.
# PIPELINE_MAX_RETRIES=24
# PIPELINE_RETRY_DELAY_SECONDS=5
# PIPELINE_RETRY_SLEEP_CAP_SECONDS=90
# PIPELINE_RATE_LIMIT_BACKOFF_MULT=1.4
# Seconds between stages (Groq defaults to ~12 when unset). Set to 0 to disable pauses:
# PIPELINE_INTER_STAGE_SLEEP_SECONDS=0

# Agents/Crew verbosity (lots of stdout; increases token-heavy traffic)
# CREW_VERBOSE=false

# MODULE: patients, appointments, vitals, admission, billing, pharmacy, labs, auth

# MODULE=builder fullstack + Node: Crew skips contracts→qa by default (overwritten after Crew by notes_stack_wire).
# BUILDER_RUN_ALL_CREW_STAGES=1

# After wiring, build_app runs ``react-native bundle`` (android dev) as a smoke test. Disable if needed:
# SKIP_RN_BUNDLE_VERIFY=1
# RN_BUNDLE_VERIFY_TIMEOUT_SECONDS=300

# After bundle/API checks, build_app runs TypeScript + ESLint complexity guardrails.
# SKIP_QUALITY_GUARDRAILS=1

# Fullstack+Node builds start the generated API temporarily and verify notes CRUD before success.
# SKIP_FULLSTACK_API_VERIFY=1
# FULLSTACK_API_VERIFY_TIMEOUT_SECONDS=20

# Stop stale Project/* Metro/devtools processes before build_app starts RN init.
# KILL_STALE_METRO=1

# Trusted automation can bypass the browser HITL gate explicitly.
# APPROVE_BLUEPRINTS=1

# Human-in-the-loop contract review webpage. By default, build_app opens
# http://127.0.0.1:8765/ and blocks until APPROVE CONTRACT is clicked.
# HITL_REVIEW_HOST=127.0.0.1
# HITL_REVIEW_PORT=8765
# HITL_REVIEW_TIMEOUT_SECONDS=3600
# HITL_OPEN_BROWSER=1
# HITL_WEBHOOK_URL=https://example.com/contract-review-webhook

# LightRAG topological memory. After HITL approval, build_app tries to ingest
# generated OpenAPI/AsyncAPI contracts into LightRAG before agents run.
# LIGHTRAG_URL=http://127.0.0.1:9621
# LIGHTRAG_API_KEY=change-me-local-key
# SKIP_LIGHTRAG_MEMORY=1
# REQUIRE_LIGHTRAG_MEMORY=1
# LIGHTRAG_INGEST_TIMEOUT_SECONDS=120
# LIGHTRAG_QUERY_TIMEOUT_SECONDS=45

