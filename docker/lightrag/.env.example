# Copy this file to docker/lightrag/.env and fill secrets before starting LightRAG.

# Server
LIGHTRAG_PORT=9621
LIGHTRAG_API_KEY=change-me-local-key
WHITELIST_PATHS=/health,/api/*

# LLM used by LightRAG for entity extraction and query synthesis.
LLM_BINDING=openai
LLM_MODEL=gpt-4o-mini
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=your_openai_or_openai_compatible_key

# Embeddings used by LightRAG.
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_BINDING_API_KEY=your_openai_or_openai_compatible_key
EMBEDDING_DIM=1536

# Ingestion performance defaults.
MAX_ASYNC=4
MAX_PARALLEL_INSERT=2
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100
TOP_K=40
ENABLE_LLM_CACHE=true
